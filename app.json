{
  "expo": {
    "name": "Listrr",
    "slug": "listrr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Branding/logo.png",
    "scheme": "listrr",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.listrr.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "icon": "./assets/Branding/logo.png"
    },
    "android": {
      "package": "com.listrr.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/Branding/logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/Branding/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Listrr needs access to your photos to allow uploading custom profile pictures."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}