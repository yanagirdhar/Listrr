{
  "expo": {
    "name": "Listrr",
    "slug": "listrr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "listrr",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.listrr.app",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.listrr.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0266A2", 
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "cover"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": false
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "listrr",
          "organization": "kamalo-3w"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "a5319248-ee29-4798-a20c-2a64abda3dec"
      },
      "router": {}
    },
    "owner": "yanagirdhar"
  }
}
